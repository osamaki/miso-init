#!/usr/bin/env bash
set -euo pipefail

show_help() {
  cat <<'HELP'
Initialize a miso app for the WebAssembly backend using the non-Nix ghc-wasm bootstrap toolchain.

Usage:
  miso-init [OPTIONS] [DIR]

Options:
  -f, --force                 生成対象の既存ファイル・非空ディレクトリがあっても上書きして続行
      --miso-ref REF          cabal.project で使う miso の git 参照を指定
      --miso-version VERSION  miso の release tag を指定し、対応する package version に pin
                              1.11 のように patch version を省略した場合は最新の 1.11.x を解決
  -h, --help                  このヘルプを表示

Behavior:
  - DIR を指定した場合:
      そのディレクトリを作成して、そこへ miso wasm プロジェクトを生成します
  - DIR を省略した場合:
      カレントディレクトリに生成します

Examples:
  miso-init hello-miso
  miso-init --miso-version 1.11 hello-miso
  miso-init --miso-version 1.11.0 hello-miso
  miso-init --miso-ref 2853fb4f26175f51ae7b9aaf0ec683c45070d06e hello-miso
  mkdir hello-miso && cd hello-miso && miso-init
  miso-init --force
HELP
}

force=0
target_dir=""
positional_count=0
default_miso_ref="1.11.0"
default_miso_package_version="1.11.0.0"
miso_ref="$default_miso_ref"
miso_version="$default_miso_package_version"
miso_ref_option=""
needs_miso_version_resolution=0
miso_version_input=""

usage_error() {
  echo "error: $1" >&2
  echo >&2
  show_help >&2
  exit 1
}

set_target_dir() {
  positional_count=$((positional_count + 1))
  if [ "$positional_count" -gt 1 ]; then
    usage_error "too many arguments"
  fi

  target_dir="$1"
}

validate_miso_ref() {
  option="$1"
  value="$2"

  if [ -z "$value" ]; then
    usage_error "$option requires a value"
  fi

  case "$value" in
    -*)
      usage_error "$option requires a non-option value"
      ;;
    *[[:space:]]*)
      usage_error "$option value must not contain whitespace"
      ;;
  esac
}

set_miso_ref() {
  value="$1"
  validate_miso_ref "--miso-ref" "$value"

  if [ "$miso_ref_option" = "version" ]; then
    usage_error "--miso-ref and --miso-version cannot be used together"
  fi

  miso_ref="$value"
  miso_version=""
  miso_ref_option="ref"
  needs_miso_version_resolution=0
  miso_version_input=""
}

miso_package_version_for_ref() {
  value="$1"

  case "$value" in
    *.*.*.*)
      printf '%s\n' "$value"
      ;;
    *.*.*)
      printf '%s.0\n' "$value"
      ;;
    *)
      printf '%s\n' "$value"
      ;;
  esac
}

miso_ref_for_package_version() {
  value="$1"

  case "$value" in
    *.*.*.0)
      printf '%s\n' "${value%.0}"
      ;;
    *)
      printf '%s\n' "$value"
      ;;
  esac
}

set_miso_version() {
  value="$1"
  validate_miso_ref "--miso-version" "$value"

  if [[ ! "$value" =~ ^[0-9]+(\.[0-9]+){0,3}$ ]]; then
    usage_error "--miso-version must look like 1, 1.11, 1.11.0, or 1.11.0.0"
  fi

  if [ "$miso_ref_option" = "ref" ]; then
    usage_error "--miso-ref and --miso-version cannot be used together"
  fi

  miso_ref="$(miso_ref_for_package_version "$value")"
  miso_version="$(miso_package_version_for_ref "$value")"
  miso_ref_option="version"

  case "$value" in
    *.*.*)
      needs_miso_version_resolution=0
      miso_version_input=""
      ;;
    *)
      needs_miso_version_resolution=1
      miso_version_input="$value"
      ;;
  esac
}

resolve_miso_version() {
  version_prefix="$1"
  tag_prefix="$version_prefix."
  case "$version_prefix" in
    *.*)
      suggested_version="$version_prefix.0"
      ;;
    *)
      suggested_version="$version_prefix.0.0"
      ;;
  esac

  command -v git >/dev/null 2>&1 || {
    echo "error: --miso-version $version_prefix requires git to resolve the latest ${version_prefix}.x release." >&2
    echo "Specify a full version such as --miso-version $suggested_version to work offline." >&2
    exit 1
  }

  latest="$(
    git ls-remote --tags --refs https://github.com/dmjio/miso.git 2>/dev/null \
      | awk '{ print $2 }' \
      | sed 's#^refs/tags/##' \
      | grep -E "^${tag_prefix//./\\.}[0-9]+(\\.[0-9]+)*$" \
      | sort -t . -k1,1n -k2,2n -k3,3n -k4,4n \
      | tail -n 1
  )" || true

  if [ -z "$latest" ]; then
    echo "error: could not resolve the latest miso $version_prefix release." >&2
    echo "Network access to GitHub may be unavailable, or no ${version_prefix}.x tag exists." >&2
    echo "Specify a full version such as --miso-version $suggested_version to work offline." >&2
    exit 1
  fi

  miso_ref="$latest"
  miso_version="$(miso_package_version_for_ref "$latest")"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      show_help
      exit 0
      ;;
    -f|--force)
      force=1
      shift
      ;;
    --miso-ref)
      if [ "$#" -lt 2 ]; then
        usage_error "--miso-ref requires a value"
      fi
      set_miso_ref "$2"
      shift 2
      ;;
    --miso-ref=*)
      set_miso_ref "${1#--miso-ref=}"
      shift
      ;;
    --miso-version)
      if [ "$#" -lt 2 ]; then
        usage_error "--miso-version requires a value"
      fi
      set_miso_version "$2"
      shift 2
      ;;
    --miso-version=*)
      set_miso_version "${1#--miso-version=}"
      shift
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        set_target_dir "$1"
        shift
      done
      ;;
    -*)
      usage_error "unknown option: $1"
      ;;
    *)
      set_target_dir "$1"
      shift
      ;;
  esac
done

if [ "$#" -gt 0 ]; then
  usage_error "too many arguments"
fi

if [ -z "$target_dir" ]; then
  target_dir="."
else
  mkdir -p "$target_dir"
fi

if [ "$target_dir" = "." ]; then
  raw="$(basename "$PWD")"
else
  raw="$(basename "$target_dir")"
fi

pkg="$(
  printf '%s' "$raw" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9-]+/-/g; s/^-+//; s/-+$//; s/-+/-/g'
)"

if [ -z "$pkg" ]; then
  pkg="miso-app"
fi

check_conflict() {
  path="$1"

  if [ ! -e "$path" ]; then
    return 1
  fi

  if [ -d "$path" ]; then
    if [ -z "$(find "$path" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]; then
      return 1
    fi
    return 0
  fi

  return 0
}

conflicts=(
  "$target_dir/app"
  "$target_dir/static"
  "$target_dir/cabal.project"
  "$target_dir"/*.cabal
  "$target_dir/bin/build-web.sh"
  "$target_dir/bin/serve.sh"
  "$target_dir/.gitignore"
)

if [ "$force" -ne 1 ]; then
  found_conflict=0
  for path in "${conflicts[@]}"; do
    if check_conflict "$path"; then
      if [ "$found_conflict" -eq 0 ]; then
        echo "error: generated paths already exist. Refusing to overwrite without --force:" >&2
        found_conflict=1
      fi
      echo "  $path" >&2
    fi
  done

  if [ "$found_conflict" -eq 1 ]; then
    exit 1
  fi
fi

if [ "$needs_miso_version_resolution" -eq 1 ]; then
  resolve_miso_version "$miso_version_input"
fi

mkdir -p "$target_dir/app" "$target_dir/bin" "$target_dir/static"

miso_constraint="miso >= 1.9"
if [ -n "$miso_version" ]; then
  miso_constraint="miso == $miso_version"
fi

cat > "$target_dir/cabal.project" <<CABAL_PROJECT
packages: .

allow-newer: all:base

source-repository-package
  type: git
  location: https://github.com/dmjio/miso
  tag: $miso_ref

package miso
  flags: +template-haskell
CABAL_PROJECT

cat > "$target_dir/$pkg.cabal" <<CABAL
cabal-version: 3.0
name: $pkg
version: 0.1.0.0
build-type: Simple

common warnings
  ghc-options:
    -Wall
    -O2
    -ferror-spans

common wasm
  if arch(wasm32)
    ghc-options:
      -no-hs-main
      -optl-mexec-model=reactor
      "-optl-Wl,--export=hs_start"
    cpp-options:
      -DWASM

executable app
  import: warnings, wasm
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base < 5
    , $miso_constraint
  default-language: Haskell2010
CABAL

cat > "$target_dir/app/Main.hs" <<'HS'
{-# LANGUAGE CPP #-}
{-# LANGUAGE LambdaCase #-}
{-# LANGUAGE OverloadedStrings #-}

module Main where

import Miso
import Miso.Html.Element as H
import Miso.Html.Event as E
import Miso.Lens

data Action
  = Increment
  | Decrement
  deriving (Show, Eq)

#ifdef WASM
foreign export javascript "hs_start" main :: IO ()
#endif

main :: IO ()
main = startApp defaultEvents app

app :: App Int Action
app = vcomp 0 updateModel viewModel

updateModel :: Action -> Effect parent props Int Action
updateModel = \case
  Increment -> this += 1
  Decrement -> this -= 1

viewModel :: () -> Int -> View Int Action
viewModel _ n =
  H.div_ []
    [ H.h1_ [] [ text "Hello, miso" ]
    , H.div_ [] [ text (ms (show n)) ]
    , H.div_ []
        [ H.button_ [ E.onClick Decrement ] [ text "-" ]
        , H.button_ [ E.onClick Increment ] [ text "+" ]
        ]
    ]
HS

cat > "$target_dir/static/index.html" <<'HTML'
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>miso app</title>
  </head>
  <body>
    <script src="./index.js" type="module"></script>
  </body>
</html>
HTML

cat > "$target_dir/static/index.js" <<'JS'
import { WASI, OpenFile, File, ConsoleStdout } from "https://cdn.jsdelivr.net/npm/@bjorn3/browser_wasi_shim@0.3.0/dist/index.js";
import ghc_wasm_jsffi from "./ghc_wasm_jsffi.js";

const args = [];
const env = ["GHCRTS=-H64m"];
const fds = [
  new OpenFile(new File([])),
  ConsoleStdout.lineBuffered((msg) => console.log(`[WASI stdout] ${msg}`)),
  ConsoleStdout.lineBuffered((msg) => console.warn(`[WASI stderr] ${msg}`)),
];
const wasi = new WASI(args, env, fds, { debug: false });

const instance_exports = {};

const { instance } = await WebAssembly.instantiateStreaming(fetch("./app.wasm"), {
  wasi_snapshot_preview1: wasi.wasiImport,
  ghc_wasm_jsffi: ghc_wasm_jsffi(instance_exports),
});

Object.assign(instance_exports, instance.exports);
wasi.initialize(instance);

await instance.exports.hs_start();
JS

cat > "$target_dir/bin/build-web.sh" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

command -v wasm32-wasi-cabal >/dev/null 2>&1 || {
  echo "wasm32-wasi-cabal が見つかりません。先に source ~/.ghc-wasm/env を実行してください。" >&2
  exit 1
}
command -v wasm32-wasi-ghc >/dev/null 2>&1 || {
  echo "wasm32-wasi-ghc が見つかりません。先に source ~/.ghc-wasm/env を実行してください。" >&2
  exit 1
}

public_dir="public"
public_marker="$public_dir/.miso-init-generated"

if [ -d "$public_dir" ] && [ ! -f "$public_marker" ]; then
  {
    echo "error: public/ exists but was not generated by miso-init."
    echo "Move files you want to keep into static/, or remove public/ manually if it is disposable."
  } >&2
  exit 1
fi

wasm32-wasi-cabal build

wasm_path="$(wasm32-wasi-cabal list-bin exe:app | tail -n 1)"
libdir="$(wasm32-wasi-ghc --print-libdir)"

# public/ is generated. Put source assets in static/.
rm -rf "$public_dir"
mkdir -p "$public_dir"
cp -r static/. "$public_dir"/
printf '%s\n' "Generated by miso-init. Do not edit files in this directory; put source assets in static/." > "$public_marker"

"$libdir/post-link.mjs" \
  --input "$wasm_path" \
  --output "$public_dir/ghc_wasm_jsffi.js"

cp "$wasm_path" "$public_dir/app.wasm"

echo
echo "Built:"
echo "  $public_dir/index.html"
echo "  $public_dir/index.js"
echo "  $public_dir/ghc_wasm_jsffi.js"
echo "  $public_dir/app.wasm"
SH

cat > "$target_dir/bin/serve.sh" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

port="${PORT:-8000}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --port)
      if [ "$#" -lt 2 ]; then
        echo "error: --port requires a value" >&2
        exit 1
      fi
      port="$2"
      shift 2
      ;;
    --port=*)
      port="${1#--port=}"
      if [ -z "$port" ]; then
        echo "error: --port requires a value" >&2
        exit 1
      fi
      shift
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

python3 -m http.server "$port" -d public
SH

cat > "$target_dir/.gitignore" <<'GITIGNORE'
dist-newstyle/
public/
GITIGNORE

chmod +x "$target_dir/bin/build-web.sh" "$target_dir/bin/serve.sh"

echo "Created project in $target_dir"
echo "Package name: $pkg"
echo "Miso ref: $miso_ref"
echo "Next:"
echo "  source ~/.ghc-wasm/env"
echo "  bin/build-web.sh"
echo "  bin/serve.sh"
